<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.example.approval24.dao.DeptWorkDAO">

<!-- 특정 민원서식의 매핑 부서 -->
<select id="deptByCategory" parameterType="long" resultType="DeptWorkDTO">
	SELECT d.dept_id, d.dept_name, dw.complain_category_id
	FROM t1000_department_work dw
	JOIN t1000_department d ON d.dept_id = dw.department_id
	WHERE dw.complain_category_id=#{complainCategoryId}
</select>

<!-- 단일 매핑 -->
<insert id="insertDW">
	insert into t1000_department_work (department_id, complain_category_id)
	values (#{deptId,jdbcType=NUMERIC}, #{complainCategoryId,jdbcType=NUMERIC})
</insert>

<!-- 부서와 기관 매핑 삭제 -->
<delete id="deleteDW">
	delete from t1000_department_work
	where complain_category_id = #{complainCategoryId}
</delete>

</mapper>