<%@page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>

<div id="wrapper">

    <%@ include file="/WEB-INF/views/common/sidebar.jsp" %>

    <div id="content-wrapper" class="d-flex flex-column">

        <div id="content">

            <%@ include file="/WEB-INF/views/common/navbar.jsp" %>

            <div class="container-fluid">

                <div class="d-sm-flex align-items-center justify-content-between mb-4">
                    <h1 class="h3 mb-0 text-gray-800">${logindeptName}</h1>
                </div>


                <div class="row">

                    <div class="col-xl-4 col-lg-5 mb-4 d-flex flex-column">
                        <div class="row flex-grow-1">

                            <div class="col-6 mb-4 d-flex">
                                <div class="card border-left-primary shadow h-100 flex-fill py-2">
                                    <div class="card-body">
                                        <div class="row no-gutters align-items-center">
                                            <div class="col mr-2">
                                                <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                                    내 전체 결재건
                                                </div>
                                                <div class="h5 mb-0 font-weight-bold text-gray-800">${totalApproval}</div>
                                            </div>
											<div class="col-auto">
												<img
													src="${pageContext.request.contextPath}/resources/assets/img/approval-total-icon .svg"
													style="width: 45px;">
											</div>
										</div>
                                    </div>
                                    <a href="${pageContext.request.contextPath}/ApprovalHistory/list" class="ml-4">전체 결재 조회 →</a>
                                </div>
                            </div>

                            <div class="col-6 mb-4 d-flex">
                                <div class="card border-left-success shadow h-100 flex-fill py-2">
                                    <div class="card-body">
                                        <div class="row no-gutters align-items-center">
                                            <div class="col mr-2">
                                                <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                                    대기중인 결재
                                                </div>
                                                <div class="h5 mb-0 font-weight-bold text-gray-800">${waitingApproval}</div>
                                            </div>
                                            <div class="col-auto">
                                                <img src="${pageContext.request.contextPath}/resources/assets/img/approval-waiting-icon.svg" style="width: 40px;">
                                            </div>
                                        </div>
                                    </div>
                                    <a href="${pageContext.request.contextPath}/ApprovalHistory/list?approvalStatusCd=E001" class="ml-4">대기중인 결재 조회 →</a>
                                </div>
                            </div>

                            <div class="col-6 mb-4 d-flex">
                                <div class="card border-left-info shadow h-100 flex-fill py-2">
                                    <div class="card-body">
                                        <div class="row no-gutters align-items-center">
                                            <div class="col mr-2">
                                                <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                                    승인한 결재
                                                </div>
                                                <div class="h5 mb-0 font-weight-bold text-gray-800">${refuseApproval}</div>
                                            </div>
                                            <div class="col-auto">
                                                <img src="${pageContext.request.contextPath}/resources/assets/img/approval-complete-icon.svg" style="width: 38px;">
                                            </div>
                                        </div>
                                    </div>
                                     <a href="${pageContext.request.contextPath}/ApprovalHistory/list?approvalStatusCd=E002" class="ml-4">승인한 결재 조회 →</a>
                                </div>
                            </div>

                            <div class="col-6 mb-4 d-flex">
                                <div class="card border-left-warning shadow h-100 flex-fill py-2">
                                    <div class="card-body">
                                        <div class="row no-gutters align-items-center">
                                            <div class="col mr-2">
                                                <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                                    반려한 결재
                                                </div>
                                                <div class="h5 mb-0 font-weight-bold text-gray-800">${approvalInTransit}</div>
                                            </div>
                                            <div class="col-auto">
                                                <img src="${pageContext.request.contextPath}/resources/assets/img/approval-cancel-icon.svg" style="width: 43px;">
                                            </div>
                                        </div>
                                    </div>
                                      <a href="${pageContext.request.contextPath}/ApprovalHistory/list?approvalStatusCd=E003" class="ml-4">반려한 결재 조회 →</a>
                                </div>
                            </div>

                        </div>
                    </div>

					<!-- 공지사항 -->
                    <div class="col-xl-8 col-lg-7 mb-4 d-flex">
                        <div class="card shadow mb-4 flex-fill">
                            <div class="card-header py-3">
                                <h6 class="m-0 font-weight-bold text-primary">공지사항</h6>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-bordered table-hover table-sm text-center align-middle">
                                    	<thead class="thead-light">
											<tr>
											<th class="text-center">제목</th>
											<th class="text-center">등록일</th>
											<th class="text-center">조회수</th>
										<thead>
                                        <tbody>
                                            <c:forEach var="notice" items="${noticeList}">
                                                <tr class="clickable-row" 
                                                    data-href="${pageContext.request.contextPath}/notice/detail/${notice.noticeId}" 
                                                    style="cursor: pointer;">
                                                    <td class="text-left">${notice.title}</td>
                                                    <td class="text-center">
                                                        <fmt:formatDate value="${notice.createDt}" pattern="yyyy'년 'MM'월 'dd'일'" />
                                                    </td>
                                                    <td class="text-center">${notice.viewCount}</td>
                                                </tr>
                                            </c:forEach>
                                        </tbody>
                                    </table>
                                </div>
                                <a href="/approval24/notice">공지사항 조회하기 →</a>
                            </div>
                        </div>
                    </div>

                </div> <!-- END ROW -->

            </div>
        </div>


    </div>
</div>

<a class="scroll-to-top rounded" href="#page-top">
    <i class="fas fa-angle-up"></i>
</a>
