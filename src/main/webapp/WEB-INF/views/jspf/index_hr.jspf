							</div>
							<!-- Card Body -->
							<div class="card-body">
								<div class="chart-pie pt-1 pb-1">
									<canvas id="myPieChart"></canvas>
								</div>
								<div class="mt-４ text-center small">
									<span class="mr-2"> <i class="fas fa-circle text-primary"></i> 실업급여팀
									</span> <span class="mr-2"> <i class="fas fa-circle text-success"></i> 취업지원팀
									</span> <span class="mr-2"> <i class="fas fa-circle text-info"></i> 출산휴가팀
									</span>
