<%@page pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>

<div id="wrapper">

    <%@ include file="/WEB-INF/views/common/sidebar.jsp"%>

    <div id="content-wrapper" class="d-flex flex-column">

        <div id="content">

            <%@ include file="/WEB-INF/views/common/navbar.jsp"%>

            <div class="container-fluid">

                <!-- Page Title -->
                <div class="d-sm-flex align-items-center justify-content-between mb-4">
                    <h1 class="h3 mb-0 text-gray-800">인사 팀</h1>
                </div>

                <!-- Main Row -->
                <div class="row">

                    <!-- Left Stats Column -->
                    <div class="col-xl-4 col-lg-5 mb-4 d-flex flex-column">

                        <div class="row flex-grow-1">

                            <!-- 전체 계정 -->
                            <div class="col-6 mb-4 d-flex">
                                <div class="card border-left-primary shadow h-100 flex-fill py-2">
                                    <div class="card-body">
                                        <div class="row no-gutters align-items-center">
                                            <div class="col mr-2">
                                                <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                                    기관내 전체 계정
                                                </div>
                                                <div class="h5 mb-0 font-weight-bold text-gray-800">${total}</div>
                                            </div>
                                            <div class="col-auto">
                                                <i class="fas fa-users fa-2x text-gray-300"></i>
                                            </div>
                                        </div>
                                    </div>
                                           <a href="${pageContext.request.contextPath}/account/list" class="ml-4">전체 계정 조회 →</a>
                                </div>
                            </div>

                            <!-- 활성 계정 -->
                            <div class="col-6 mb-4 d-flex">
                                <div class="card border-left-success shadow h-100 flex-fill py-2">
                                    <div class="card-body">
                                        <div class="row no-gutters align-items-center">
                                            <div class="col mr-2">
                                                <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                                    활성 계정
                                                </div>
                                                <div class="h5 mb-0 font-weight-bold text-gray-800">${enableAccount}</div>
                                            </div>
                                            <div class="col-auto">
                                                <img src="${pageContext.request.contextPath}/resources/assets/img/enable-icon.svg"
                                                     style="width: 40px;">
                                            </div>
                                        </div>
                                    </div>
                                    	<a href="${pageContext.request.contextPath}/account/list?accountStatusCd=B002" class="ml-4">활성화 계정 조회 →</a>
                                    	
                                </div>
                            </div>

                            <!-- 승인 대기 -->
                            <div class="col-6 mb-4 d-flex">
                                <div class="card border-left-info shadow h-100 flex-fill py-2">
                                    <div class="card-body">
                                        <div class="row no-gutters align-items-center">
                                            <div class="col mr-2">
                                                <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                                    승인 대기
                                                </div>
                                                <div class="row no-gutters align-items-center">
                                                    <div class="col-auto">
                                                        <div class="h5 mb-0 mr-3 font-weight-bold text-gray-800">${waitingAccount}</div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-auto">
                                                <img src="${pageContext.request.contextPath}/resources/assets/img/waiting-icon.svg"
                                                     style="width: 40px;">
                                            </div>
                                        </div>
                                    </div>
                                    <a href="${pageContext.request.contextPath}/account/list?accountStatusCd=B001" class="ml-4">대기 계정 조회 →</a>
                                </div>
                            </div>

                            <!-- 잠긴 계정 -->
                            <div class="col-6 mb-4 d-flex">
                                <div class="card border-left-warning shadow h-100 flex-fill py-2">
                                    <div class="card-body">
                                        <div class="row no-gutters align-items-center">
                                            <div class="col mr-2">
                                                <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                                    잠긴 계정
                                                </div>
                                                <div class="h5 mb-0 font-weight-bold text-gray-800">${lockAccount}</div>
                                            </div>
                                            <div class="col-auto">
                                                <img src="${pageContext.request.contextPath}/resources/assets/img/lock-icon.svg"
                                                     style="width: 45px;">
                                            </div>
                                        </div>
                                    </div>
                                    <a href="${pageContext.request.contextPath}/account/list?accountStatusCd=B005" class="ml-4">잠긴 계정 조회 →</a>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- Right Notice List -->
          			<div class="col-xl-8 col-lg-7 mb-4 d-flex">
                        <div class="card shadow mb-4 flex-fill">
                            <div class="card-header py-3">
                                <h6 class="m-0 font-weight-bold text-primary">공지사항</h6>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-bordered" width="100%" cellspacing="0">
                                        <tbody>
                                            <c:forEach var="notice" items="${noticeList}">
                                                <tr class="clickable-row" 
                                                    data-href="${pageContext.request.contextPath}/notice/detail/${notice.noticeId}" 
                                                    style="cursor: pointer;">
                                                    <td>${notice.title}</td>
                                                    <td>
                                                        <fmt:formatDate value="${notice.createDt}" pattern="yyyy'년 'MM'월 'dd'일'" />
                                                    </td>
                                                    <td>${notice.viewCount}</td>
                                                </tr>
                                            </c:forEach>
                                        </tbody>
                                    </table>
                                </div>
                                <a href="/approval24/notice">공지사항 조회 →</a>
                            </div>
                        </div>
                    </div>

                </div><!-- End Row -->

            </div><!-- End Container-fluid -->

        </div><!-- End Content -->

        <!-- Footer -->
        <footer class="sticky-footer bg-white">
            <div class="container my-auto">
                <div class="copyright text-center my-auto">
                    <span>행정 &copy; 결재24 2025</span>
                </div>
            </div>
        </footer>

    </div><!-- End Content-wrapper -->

</div><!-- End Wrapper -->

<a class="scroll-to-top rounded" href="#page-top">
    <i class="fas fa-angle-up"></i>
</a>
